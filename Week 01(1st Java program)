        } else {
            System.out.println("Fail");
        }
    }
} public class LargestNumber {
    public static void main(String[] args) {
        int A = 15;
        int B = 25;
        int C = 10;

        if (A >= B && A >= C) {
            System.out.println("A is the largest");
        } else if (B >= A && B >= C) {
            System.out.println("B is the largest");
        } else {
            System.out.println("C is the largest");
        }
    }
